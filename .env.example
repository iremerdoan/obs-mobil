# Bu dosyanın bir kopyasını ".env.local" adıyla oluştur ve değerleri Supabase'den yapıştır:
# Supabase paneli → Project Settings → API (ya da Data API / API Keys)
#   Project URL           → EXPO_PUBLIC_SUPABASE_URL
#   publishable (anon) key → EXPO_PUBLIC_SUPABASE_KEY
# NOT: Buraya "secret" ya da "service_role" anahtarını ASLA yazma.

EXPO_PUBLIC_SUPABASE_URL=https://PROJE-KODUN.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=BURAYA_PUBLISHABLE_ANAHTAR
